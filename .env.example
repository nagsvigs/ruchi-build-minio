# =============================================================
# Ruchi voice_agent_functions — environment template
# =============================================================
# ALL VARIABLES ARE OPTIONAL.
#
# The demo works with zero config:
#   - voice output uses edge-tts (free, no key)
#   - voice input uses Vosk (offline, no key)
#   - the 12 tools use the keyword mock runner
#
# Set GOOGLE_API_KEY to replace the mock runner with real Gemini
# function-calling.
# =============================================================

# ---- LLM (optional) ----
# Without this the keyword mock runner handles all 12 tools.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# ---- Latency tuning (optional) ----
# Cap "thinking" tokens so replies stay fast (set -1 to omit).
GEMINI_THINKING_BUDGET=128
GEMINI_MAX_OUTPUT_TOKENS=512
# Per-attempt HTTP timeout, per-call ceiling, whole-turn ceiling (seconds).
GEMINI_REQUEST_TIMEOUT=8
GEMINI_TOTAL_TIMEOUT=16
GEMINI_TURN_TIMEOUT=22

# ---- Voice (optional; defaults work out of the box) ----
# edge-tts is free and keyless. These override defaults if needed.
RUCHI_TTS_VOICE=te-IN-ShrutiNeural
# Alternative: te-IN-MohanNeural (male)

# ---- Voice: ElevenLabs TTS (optional) ----
# Without these, Ruchi falls back to edge-tts (free, no key).
# Get a key at https://elevenlabs.io (any custom/cloned voice works).
ELEVEN_API_KEY=
ELEVEN_VOICE_ID=
# ELEVEN_MODEL_ID=eleven_v3_conversational

# ---- Persistent memory (optional) ----
# Postgres + pgvector for sessions, history, long-term memories and
# recipe RAG. Start it with:
#   docker compose -f infra/docker-compose.yaml up -d postgres
# Set MEMORY_ENABLED=0 to disable all memory features.
DATABASE_URL=postgresql://ruchi:ruchi@127.0.0.1:5432/ruchi
MEMORY_ENABLED=1
MEMORY_TOP_K=5
MEMORY_SEARCH_THRESHOLD=0.55
MEMORY_DEDUP_THRESHOLD=0.85
MEMORY_RECENT_TURNS=12
# Background memory extraction via Gemini (shares the GOOGLE_API_KEY quota).
MEMORY_EXTRACT=1
# Local embeddings (fastembed, no API key). 384-dim multilingual model.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSIONS=384
EMBEDDING_CACHE_DIR=data/fastembed
# Memories for clients that don't send a user_id.
DEFAULT_USER_ID=default

# ---- Server ----
PORT=8000

# ---- Server ----
PORT=8000

# ---- Session recordings (optional) ----
# Both the mic audio and Ruchi's TTS already pass through the server, so
# each session is mixed into one MP3 at recordings/<session_id>.mp3.
# Set RECORDING_ENABLED=0 to turn this off.
RECORDING_ENABLED=1
# RECORDINGS_DIR=/absolute/path/to/recordings

# 0 = auto (all cores). Set e.g. 8 to cap CPU use.

# ---- STT: Sarvam (Telugu, realtime + batch) ----
# Optional. Without it, Ruchi falls back to Vosk (offline).
SARVAM_API_KEY=
SARVAM_MODEL=saaras:v3
SARVAM_LANGUAGE=te-IN
# Realtime WebSocket tuning (turn detection).
SARVAM_REALTIME_MODEL=saaras:v3-realtime
SARVAM_STREAM_TYPE=fast
SARVAM_ENDPOINTING=vad
SARVAM_VAD_THRESHOLD=0.3
SARVAM_SILENCE_MS=500
SARVAM_MIN_SPEECH_MS=250

# ---- MinIO: mirror session recordings to object storage ----
# The local recordings/ flow is unchanged; finalized MP3s are also
# uploaded to MinIO in the background (see infra/docker-compose.yaml).
MINIO_ENABLED=1
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY falls back to MINIO_ROOT_PASSWORD, then minioadmin
MINIO_BUCKET=recordings
# MINIO_PUBLIC_URL=http://127.0.0.1:9000
